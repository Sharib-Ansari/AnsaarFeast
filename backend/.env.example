# MongoDB Atlas connection string
MONGO_URI=

# JWT secret — use a long, random string (e.g. openssl rand -hex 32)
JWT_SECRET=

# OpenCage Geocoding API key — https://opencagedata.com/
# IMPORTANT: This key was previously hardcoded in source code.
# Revoke the old key and generate a new one before any public deployment.
OPENCAGE_API_KEY=

# Allowed frontend origin for CORS (no trailing slash)
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:3000

# Server port (optional — defaults to 5000)
PORT=5000
